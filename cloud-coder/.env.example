# Generate a long random secret before deployment. Never commit real secrets.
ACCESS_TOKEN=replace-with-a-long-random-secret
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=put-your-own-openai-api-key-in-local-env
UPSTREAM_MODEL=gpt-6-sol
REQUEST_TIMEOUT_SECONDS=180
MAX_REQUEST_BYTES=200000
ALLOWED_ORIGINS=http://localhost:4173
